<Page x:Class="QL_Nha_sach.Pages.SignUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages"
	  xmlns:controls="clr-namespace:QL_Nha_sach.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SignUpPage">

	<Border Background="#FFFFFF" CornerRadius="12" Padding="30" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
		<Border.Effect>
			<DropShadowEffect BlurRadius="25" ShadowDepth="3" Direction="270" Color="#CCCCCC" Opacity="0.4"/>
		</Border.Effect>
		
		<StackPanel>
			<TextBlock Text="Create New Account" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

			<TextBlock Text="{DynamicResource Str_Username}" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
			<TextBox Text="{Binding Username}" Height="36" VerticalContentAlignment="Center" Padding="10,0" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="1"/>

			<TextBlock Text="{DynamicResource Str_Password}" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
			<!-- Name given to pass as a parameter -->
			<PasswordBox x:Name="TxtPassword" Height="36" Padding="10,0" VerticalContentAlignment="Center" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="1"/>

			<TextBlock Text="{DynamicResource Str_FullName}" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,16,0,6"/>
			<TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"/>

			<TextBlock Text="{DynamicResource Str_PhoneNumber}" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,16,0,6"/>
			<TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"/>

			<TextBlock Text="{DynamicResource Str_EmailAddress}" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,16,0,6"/>
			<TextBox Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"/>

			<!-- Pass the PasswordBox control as a parameter to the Command -->
			<Button Content="Sign Up" Command="{Binding SignUpCommand}" CommandParameter="{Binding ElementName=TxtPassword}" Background="#2B5B84" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,0" Height="40" Cursor="Hand">
				<Button.Resources>
					<Style TargetType="Border">
						<Setter Property="CornerRadius" Value="6" />
					</Style>
				</Button.Resources>
			</Button>
			<Button Content="Back" Click="ExitButton_Click" Background="#2B5B84" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,0" Height="40" Cursor="Hand">
				<Button.Resources>
					<Style TargetType="Border">
						<Setter Property="CornerRadius" Value="6" />
					</Style>
				</Button.Resources>
			</Button>

			<controls:MessageBanner HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Panel.ZIndex="100"/>
		</StackPanel>
	</Border>
</Page>
