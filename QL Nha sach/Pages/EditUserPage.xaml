<Page x:Class="QL_Nha_sach.Pages.EditUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages"
      xmlns:controls="clr-namespace:QL_Nha_sach.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditUserPage">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Controls/SharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Page.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Header -->
			<RowDefinition Height="*"/>
			<!-- Form Body -->
			<RowDefinition Height="Auto"/>
			<!-- Footer Actions -->
		</Grid.RowDefinitions>

		<!-- 1. Header Section -->
		<Border Grid.Row="0" Background="#F8F9FA" CornerRadius="8,8,0,0" Padding="25,20" BorderBrush="#EEE" BorderThickness="0,0,0,1">
			<Grid>
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="User Configuration" FontSize="18" FontWeight="SemiBold" Foreground="#333"/>
				</StackPanel>

				<!-- Exit button -->
				<Button Content="✖" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ExitButton}" Click="ExitButton_Click"/>
			</Grid>
		</Border>

		<!-- 2. Form Body -->
		<StackPanel Grid.Row="1">

			<!-- Row 1: Identity -->
			<Grid Margin="0,0,0,20">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="20"/>
					<!-- Spacing -->
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<TextBlock Text="Full Name" Margin="0,0,0,5"/>
					<TextBox Text="{Binding FullName}"/>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<TextBlock Text="Username" Margin="0,0,0,5"/>
					<TextBox Text="{Binding Username}"/>
				</StackPanel>
			</Grid>

			<!-- Row 2: Security & Role -->
			<Grid Margin="0,0,0,20">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="20"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<TextBlock Text="Password" Margin="0,0,0,5"/>
					<PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" />
				</StackPanel>

				<StackPanel Grid.Column="2">
					<TextBlock Text="Access Level (Role)" Margin="0,0,0,5"/>
					<ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="RoleName" SelectedItem="{Binding SelectedRole}" HorizontalAlignment="Stretch"/>
				</StackPanel>
			</Grid>

			<!-- Row 3: Contact Info -->
			<TextBlock Text="Contact Details" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,10" Foreground="#666"/>
			<Separator Margin="0,0,0,15" Background="#EEE"/>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="20"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<TextBlock Text="Phone Number" Margin="0,0,0,5"/>
					<TextBox Text="{Binding PhoneNumber}"/>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<TextBlock Text="Email Address" Margin="0,0,0,5"/>
					<TextBox Text="{Binding EmailAddress}"/>
				</StackPanel>
			</Grid>
		</StackPanel>

		<!-- 3. Footer Section -->
		<Border Grid.Row="2" Padding="25,20" Background="#F8F9FA" CornerRadius="0,0,8,8" BorderBrush="#EEE" BorderThickness="0,1,0,0">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
				<Button Content="Update" Command="{Binding SaveCommand}" Style="{StaticResource SaveButton}" Margin="0,20,0,0"/>
			</StackPanel>
		</Border>

        <controls:MessageBanner HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Panel.ZIndex="100"/>
    </Grid>
</Page>
