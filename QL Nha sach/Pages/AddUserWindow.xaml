<Window x:Class="QL_Nha_sach.Pages.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QL_Nha_sach.Pages"
		xmlns:controls="clr-namespace:QL_Nha_sach.Controls"
        mc:Ignorable="d"
        Title="AddUserWindow" Height="450" Width="800"
		WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized">
	<Grid>
		<Border Background="Black" Opacity="0.5"/>

		<Grid VerticalAlignment="Center" HorizontalAlignment="Center">
			<Border Background="#FFFFFF" CornerRadius="12" Padding="30" Width="400">
				<Border.Effect>
					<DropShadowEffect BlurRadius="25" ShadowDepth="3" Direction="270" Color="#CCCCCC" Opacity="0.4"/>
				</Border.Effect>

				<StackPanel>
					<Grid Margin="0,0,0,25">
						<StackPanel HorizontalAlignment="Center">
							<TextBlock Text="{DynamicResource Str_AddNewUser}" FontSize="24" FontWeight="Bold" Foreground="#1A252C" HorizontalAlignment="Center" Margin="0,0,0,5"/>
						</StackPanel>

						<Button Content="✖" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-15,-15,0" Click="ExitButton_Click" Style="{StaticResource ExitButton}"/>
					</Grid>

					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="15"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0">
							<TextBlock Text="{DynamicResource Str_Username}" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
							<TextBox Text="{Binding Username}" Height="36" VerticalContentAlignment="Center" Padding="10,0" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="1"/>
						</StackPanel>

						<StackPanel Grid.Column="2">
							<TextBlock Text="{DynamicResource Str_AccessLevel}" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
							<ComboBox ItemsSource="{Binding Roles}" Height="36" VerticalContentAlignment="Center" Padding="10,0" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="1" DisplayMemberPath="RoleName" SelectedItem="{Binding SelectedRole}"/>
						</StackPanel>
					</Grid>

					<Separator Background="#E2E8F0" Margin="0,10,0,20"/>

					<TextBlock Text="{DynamicResource Str_FullName}" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6"/>
					<TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"/>

					<TextBlock Text="{DynamicResource Str_PhoneNumber}" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,16,0,6"/>
					<TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"/>

					<TextBlock Text="{DynamicResource Str_EmailAddress}" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,16,0,6"/>
					<TextBox Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"/>

					<!-- New Password Field -->
					<TextBlock Text="{DynamicResource Str_Password}" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,16,0,6"/>
					<PasswordBox x:Name="NewPasswordBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"/>

					<Button Content="{DynamicResource Str_Save}" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=NewPasswordBox}" Background="#2B5B84" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="0,30,0,5" Height="42">
						<Button.Resources>
							<Style TargetType="Border">
								<Setter Property="CornerRadius" Value="6" />
							</Style>
						</Button.Resources>
					</Button>
				</StackPanel>
			</Border>

			<controls:MessageBanner HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Panel.ZIndex="100"/>
		</Grid>
	</Grid>
</Window>
