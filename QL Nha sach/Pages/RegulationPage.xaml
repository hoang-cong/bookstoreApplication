<Page x:Class="QL_Nha_sach.Pages.RegulationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages"
      xmlns:controls="clr-namespace:QL_Nha_sach.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegulationPage">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Controls/SharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Page.Resources>        

	<Grid Margin="30" Background="#F9FAFB">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Title -->
			<RowDefinition Height="*"/>
			<!-- Settings Area -->
			<RowDefinition Height="Auto"/>
			<!-- Action Bar -->
		</Grid.RowDefinitions>

		<!-- Header Section -->
		<Grid Grid.Row="0" Margin="0,0,0,25">
			<StackPanel>
				<TextBlock Text="System Regulations" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
				<TextBlock Text="Configure global constraints for stock management and sales operations." Foreground="#6B7280" FontSize="14" Margin="0,4,0,0"/>
			</StackPanel>

			<!-- Exit button -->
			<Button Content="✖" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ExitButton}" Click="ExitButton_Click"/>
		</Grid>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<!-- Left Card -->
				<ColumnDefinition Width="*"/>
				<!-- Right Card -->
			</Grid.ColumnDefinitions>
			
			<Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,15,15" Padding="20">
				
					<StackPanel>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,15">
							<TextBlock Text="📦" FontSize="20" Margin="0,0,10,0"/>
							<TextBlock Text="Inventory Rules" FontSize="20" FontWeight="Bold" Foreground="#374151"/>
						</StackPanel>

						<TextBlock Text="Maximum Stock Capacity" FontSize="18" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
						<TextBox Text="{Binding Regulation.MaxStock}" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

						<TextBlock Text="Minimum Stock Capacity" FontSize="18" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
						<TextBox Text="{Binding Regulation.MinStock}" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

						<TextBlock Text="Import Threshold" FontSize="18" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
						<TextBox Text="{Binding Regulation.StockThresholdForImport}" Height="40" VerticalContentAlignment="Center" />
						<TextBlock Text="System alerts when stock falls below this number." FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
					</StackPanel>
				
			</Border>

			<!-- Section 2: Operational Constraints -->
			<Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="15,0,0,15" Padding="20">
				
					<StackPanel>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,15">
							<TextBlock Text="⚙️" FontSize="20" Margin="0,0,10,0"/>
							<TextBlock Text="Sales &amp; Import Rules" FontSize="20" FontWeight="Bold" Foreground="#374151"/>
						</StackPanel>

						<TextBlock Text="Minimum Import Quantity" FontSize="18" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
						<TextBox Text="{Binding Regulation.MinImport}" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

						<TextBlock Text="Required Post-Sale Stock" FontSize="18" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
						<TextBox Text="{Binding Regulation.MinStockAfterSale}" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

						<TextBlock Text="Global Maximum Discount (%)" FontSize="18" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
						<TextBox Text="{Binding Regulation.Discount}" Height="35" VerticalContentAlignment="Center" />
						<TextBlock Text="Staff cannot apply discounts higher than this value." FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
					</StackPanel>
				
			</Border>
		</Grid>

		<!-- Action Bar -->
		<Border Grid.Row="2" Background="#F3F4F6" Margin="-30,0" Padding="30,20">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
				<Button Content="Update Settings" Command="{Binding SaveCommand}" Style="{StaticResource SaveButton}"/>
				<TextBlock Text="Changes take effect immediately for all users." FontSize="12" VerticalAlignment="Center" Foreground="#6B7280" Margin="10,0,20,0" FontStyle="Italic"/>
			</StackPanel>
		</Border>

		<controls:MessageBanner HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Panel.ZIndex="100"/>
	</Grid>
</Page>
