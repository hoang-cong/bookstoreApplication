<Page x:Class="QL_Nha_sach.Pages.BookManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages" xmlns:viewmodels="clr-namespace:QL_Nha_sach.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:BookViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookManagementPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Search bar -->
            <RowDefinition Height="*"/>
            <!-- Book list -->
            <RowDefinition Height="Auto"/>
            <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- Exit button -->
        <Button Content="✖"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="30" Height="30"
                Background="Transparent"
                BorderThickness="0"
                Foreground="Red"
                FontWeight="Bold"
                Click="ExitButton_Click"/>

        <!-- Search bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <TextBox Width="250" Height="30" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DockPanel>

        <!-- Book list styled like artifact cards -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Books}"
                 SelectedItem="{Binding SelectedBook}"
                 Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#bdc3c7" BorderThickness="1" CornerRadius="8" Margin="5" Padding="10" Background="White">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding AuthorNames}" Foreground="#7f8c8d"/>
                            <TextBlock Text="{Binding GenreNames}" Foreground="#95a5a6"/>
                            <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" Foreground="#27ae60"/>
                            <TextBlock Text="{Binding Stock, StringFormat=Stock: {0}}" Foreground="#2980b9"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Action buttons bottom-left -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="Add Book"
                    Command="{Binding AddBookCommand}"
                    Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Edit Selected Book"
                    Command="{Binding EditBookCommand}"
                    Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Delete Selected Book"
                    Command="{Binding DeleteBookCommand}"
                    Padding="15,5"/>
        </StackPanel>
    </Grid>
</Page>
