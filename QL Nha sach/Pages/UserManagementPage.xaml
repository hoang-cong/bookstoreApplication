<Page x:Class="QL_Nha_sach.Pages.UserManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages"
      xmlns:controls="clr-namespace:QL_Nha_sach.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserManagementPage">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Controls/SharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Page.Resources>

	<Grid Margin="24" Background="#F9FAFB">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Header -->
			<RowDefinition Height="*"/>
			<!-- Cards List -->
			<RowDefinition Height="Auto"/>
			<!-- Footer Actions -->
		</Grid.RowDefinitions>

		<!-- Header Section -->
		<Grid Grid.Row="0" Margin="0,0,0,24">
			<StackPanel>
				<TextBlock Text="Team Directory" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
				<TextBlock Text="Manage your team members and their account permissions." Foreground="#6B7280" FontSize="14" Margin="0,0,0,15"/>

				<!-- Search Bar Area -->
				<Grid Width="400" HorizontalAlignment="Left">
					<Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Height="40">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="40"/>
								<!-- Icon Space -->
								<ColumnDefinition Width="*"/>
								<!-- Text Space -->
							</Grid.ColumnDefinitions>

							<TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#9CA3AF"/>

							<TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Background="Transparent"
									 BorderThickness="0" Margin="5,0,10,0" FontSize="14" Foreground="#111827" VerticalContentAlignment="Center"/>
						</Grid>
					</Border>
				</Grid>
			</StackPanel>

			<!-- Exit button -->
			<Button Content="✖" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ExitButton}" Click="ExitButton_Click"/>
		</Grid>

		<!-- The ListBox Styled as a Card Gallery -->
		<ListBox Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel Margin="0,10,0,0" />
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>

			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border Width="280" Padding="20">
						<StackPanel>
							<!-- Top Info -->
							<Grid Margin="0,0,0,12">
								<Border Width="36" Height="36" HorizontalAlignment="Left" CornerRadius="18" Background="#F3F4F6">
									<TextBlock Text="👤" VerticalAlignment="Center" HorizontalAlignment="Center"/>
								</Border>
								<Border HorizontalAlignment="Right" Background="#EEF2FF" CornerRadius="6" Padding="8,4">
									<TextBlock Text="{Binding Role.RoleName}" Foreground="#4F46E5" FontSize="11" FontWeight="Bold"/>
								</Border>
							</Grid>

							<!-- User Details -->
							<TextBlock Text="{Binding Username}" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,2"/>
							<TextBlock Text="{Binding FullName}" FontSize="14" Foreground="#4B5563" Margin="0,0,0,12"/>

							<Separator Background="#F1F5F9" Margin="0,0,0,12"/>

							<!-- Contact Info -->
							<StackPanel Orientation="Horizontal" Margin="0,0,0,6">
								<TextBlock Text="📧" FontSize="12" Margin="0,0,8,0" Foreground="#9CA3AF"/>
								<TextBlock Text="{Binding EmailAddress}" FontSize="12" Foreground="#6B7280"/>
							</StackPanel>
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="📞" FontSize="12" Margin="0,0,8,0" Foreground="#9CA3AF"/>
								<TextBlock Text="{Binding PhoneNumber}" FontSize="12" Foreground="#6B7280"/>
							</StackPanel>

							<TextBlock Text="{Binding UserId, StringFormat='ID: {0}'}" FontSize="12" Foreground="#9CA3AF" Margin="0,12,0,0" HorizontalAlignment="Left"/>
						</StackPanel>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<!-- Footer Actions -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
			<Button Content="Add User" Command="{Binding AddUserCommand}" Style="{StaticResource SaveButton}" Width="130"/>
			<Button Content="Edit" Command="{Binding EditUserCommand}" Style="{StaticResource EditButton}" Margin="12,0" Width="100"/>
			<Button Content="Delete" Command="{Binding DeleteUserCommand}" Style="{StaticResource DeleteButton}" Width="100"/>
		</StackPanel>

		<controls:MessageBanner HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Panel.ZIndex="100"/>
	</Grid>
</Page>
