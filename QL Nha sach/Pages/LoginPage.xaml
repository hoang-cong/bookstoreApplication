<Page x:Class="QL_Nha_sach.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

	<Border x:Name="LoginForm" Background="#FFFFFF" CornerRadius="12" Padding="30" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
		<Border.Effect>
			<DropShadowEffect BlurRadius="25" ShadowDepth="3" Direction="270" Color="#CCCCCC" Opacity="0.4"/>
		</Border.Effect>

		<StackPanel>
			<!-- Header Section -->
			<TextBlock Text="Welcome Back" FontSize="24" FontWeight="Bold" Foreground="#1A252C" HorizontalAlignment="Center" Margin="0,0,0,5"/>
			<TextBlock Text="Please sign in to continue" FontSize="13" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,25"/>

			<TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6"/>
			<TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" Foreground="#2D3748"/>

			<TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,16,0,6"/>
			<!-- Fixed alignment margin here -->
			<PasswordBox x:Name="PasswordBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" Foreground="#2D3748"/>

			<Button Content="Sign In" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=PasswordBox}" Background="#2B5B84" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="0,30,0,5" Height="40" Cursor="Hand">
				<Button.Resources>
					<Style TargetType="Border">
						<Setter Property="CornerRadius" Value="6" />
					</Style>
				</Button.Resources>
			</Button>
			<Button Content="Create an account" Command="{Binding SignUpCommand}" CommandParameter="{Binding ElementName=PasswordBox}" Background="#2B5B84" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,5" Height="40" Cursor="Hand">
				<Button.Resources>
					<Style TargetType="Border">
						<Setter Property="CornerRadius" Value="6" />
					</Style>
				</Button.Resources>
			</Button>
		</StackPanel>
	</Border>
</Page>
