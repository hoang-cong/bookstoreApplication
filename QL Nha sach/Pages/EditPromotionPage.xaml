<Page x:Class="QL_Nha_sach.Pages.EditPromotionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages"
      xmlns:services="clr-namespace:QL_Nha_sach.Services"
	  xmlns:controls="clr-namespace:QL_Nha_sach.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditPromotionPage">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Controls/SharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Page.Resources>

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Header -->
			<RowDefinition Height="*"/>
			<!-- Body -->
			<RowDefinition Height="Auto"/>
			<!-- Footer -->
		</Grid.RowDefinitions>

		<!-- 1. Header Section -->
		<Border Grid.Row="0" Background="#F8F9FA" CornerRadius="12,12,0,0" Padding="25,20" BorderBrush="#EEE" BorderThickness="0,0,0,1">
			<Grid>
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="{DynamicResource Str_UpdatePromotion}" FontSize="20" FontWeight="SemiBold" Foreground="#333"/>
				</StackPanel>

				<!-- Exit button -->
				<Button Content="✖" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ExitButton}" Click="ExitButton_Click"/>
			</Grid>
		</Border>

		<!-- 2. Body Section -->
		<Grid Grid.Row="1" Margin="30,20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Left Column: Details -->
			<StackPanel Grid.Column="0">
				<TextBlock Text="{DynamicResource Str_GeneralDetails}" FontWeight="Bold" Margin="0,0,0,15" Foreground="#555"/>

				<TextBlock Text="{DynamicResource Str_PromotionName}"/>
				<TextBox Text="{Binding Name}" Margin="0,5,0,15"/>

				<Grid Margin="0,0,0,15">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" Margin="0,0,10,0">
						<TextBlock Text="{DynamicResource Str_Discount}"/>
						<TextBox Text="{Binding DiscountPercentage}" />
					</StackPanel>
				</Grid>

				<TextBlock Text="{DynamicResource Str_ValidityPeriod}"/>
				<UniformGrid Columns="2">
					<DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,5,0" HorizontalAlignment="Stretch"/>
					<DatePicker SelectedDate="{Binding EndDate}" Margin="5,0,0,0" HorizontalAlignment="Stretch"/>
				</UniformGrid>
			</StackPanel>


			<!-- Vertical Separator -->
			<Rectangle Grid.Column="1" Width="1" Fill="#EEE" Margin="25,10"/>

			<!-- Right Column: Targeting -->
			<StackPanel Grid.Column="2">
				<TextBlock Text="{DynamicResource Str_Targeting}" FontWeight="Bold" Margin="0,0,0,15" Foreground="#555"/>

				<CheckBox Content="{DynamicResource Str_Applytoallbooks}" IsChecked="{Binding ApplyToAllBooks}" Margin="0,0,0,10"/>

				<Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
					<StackPanel>
						<ListBox ItemsSource="{Binding AvailableBooks}" Height="180" BorderThickness="0" DisplayMemberPath="Title" SelectionMode="Multiple"
									services:ListBoxSelectedItemsBehavior.BindableSelectedItems="{Binding SelectedBooks}"/>
					</StackPanel>
				</Border>

				<TextBlock Text="{DynamicResource Str_Selectspecifictitlesforthisdiscount}" FontSize="11" Foreground="Gray" Margin="0,5"/>
			</StackPanel>
		</Grid>

		<!-- 3. Footer Section -->
		<Border Grid.Row="2" Padding="25,20" Background="#F8F9FA" CornerRadius="0,0,12,12">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
				<Button Content="{DynamicResource Str_Update}" Command="{Binding SaveCommand}" Style="{StaticResource SaveButton}" Margin="0,10"/>
			</StackPanel>
		</Border>
	</Grid>
</Page>
