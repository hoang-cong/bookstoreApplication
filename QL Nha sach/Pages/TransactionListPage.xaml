<Page x:Class="QL_Nha_sach.Pages.TransactionListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages"
      xmlns:controls="clr-namespace:QL_Nha_sach.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TransactionListPage">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Header Area -->
			<RowDefinition Height="*"/>
			<!-- Main Content -->
		</Grid.RowDefinitions>

		<!-- Header & Exit -->
		<Grid Grid.Row="0" Margin="0,0,0,20">
			<StackPanel>
				<TextBlock Text="Transaction History" FontSize="28" FontWeight="SemiBold" Foreground="#1A1A1A"/>
				<TextBlock Text="Review and manage your store's recent invoices and stock imports." FontSize="14" Foreground="#666"/>
			</StackPanel>
			<Button Content="✖" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ExitButton}" Click="ExitButton_Click"/>
		</Grid>

		<TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
			<!-- Modern Tab Styling -->
			<TabControl.Resources>
				<Style TargetType="TabItem">
					<Setter Property="Padding" Value="20,10"/>
					<Setter Property="FontSize" Value="15"/>
					<Setter Property="FontWeight" Value="Medium"/>
				</Style>
			</TabControl.Resources>

			<!-- Invoices Tab -->
			<TabItem Header="Sales Invoices">
				<Grid Margin="0,20,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<ListBox ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<!-- Icon/Status -->
											<ColumnDefinition Width="*"/>
											<!-- Details -->
											<ColumnDefinition Width="Auto"/>
											<!-- Date/Time -->
										</Grid.ColumnDefinitions>

										<!-- Status Icon -->
										<Ellipse Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,15,0"/>

										<StackPanel Grid.Column="1">
											<TextBlock Text="{Binding InvoiceId, StringFormat='Invoice #INV-{0}'}" FontWeight="Bold" FontSize="16" Foreground="#222"/>
											<TextBlock Text="{Binding UserId, StringFormat='Processed by Stocker: {0}'}" FontSize="13" Foreground="#888" Margin="0,2,0,0"/>
											<!-- Your specific Style for Voided text -->
											<TextBlock Style="{StaticResource VoidedStatusTextStyle}" Margin="0,4,0,0"/>
										</StackPanel>

										<StackPanel Grid.Column="2" VerticalAlignment="Center">
											<TextBlock Text="{Binding InvoiceDate, StringFormat=\{0:dd MMM yyyy\}}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
											<TextBlock Text="{Binding InvoiceDate, StringFormat=\{0:HH:mm\}}" FontSize="12" Foreground="#999" HorizontalAlignment="Right"/>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<!-- Action Bar -->
					<Border Grid.Row="1" Background="#F8F9FA" Padding="15" CornerRadius="8" Margin="0,10,0,0">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
							<Button Content="View Details" Command="{Binding OpenInvoiceDetailCommand}" Style="{StaticResource EditButton}" Margin="0,0,10,0"/>
							<Button Content="Delete Record" Command="{Binding DeleteInvoiceCommand}" Style="{StaticResource DeleteButton}"/>
						</StackPanel>
					</Border>

					<controls:MessageBanner HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Panel.ZIndex="100"/>
				</Grid>
			</TabItem>

            <!-- Imports Tab -->
			<TabItem Header="Sales Imports">
				<Grid Margin="0,20,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<ListBox ItemsSource="{Binding Imports}" SelectedItem="{Binding SelectedImport}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<!-- Icon/Status -->
											<ColumnDefinition Width="*"/>
											<!-- Details -->
											<ColumnDefinition Width="Auto"/>
											<!-- Date/Time -->
										</Grid.ColumnDefinitions>

										<!-- Status Icon -->
										<Ellipse Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,15,0"/>

										<StackPanel Grid.Column="1">
											<TextBlock Text="{Binding ImportId, StringFormat='Import #INV-{0}'}" FontWeight="Bold" FontSize="16" Foreground="#222"/>
											<TextBlock Text="{Binding UserId, StringFormat='Processed by Stocker: {0}'}" FontSize="13" Foreground="#888" Margin="0,2,0,0"/>
											<!-- Your specific Style for Voided text -->
											<TextBlock Style="{StaticResource VoidedStatusTextStyle}" Margin="0,4,0,0"/>
										</StackPanel>

										<StackPanel Grid.Column="2" VerticalAlignment="Center">
											<TextBlock Text="{Binding ImportDate, StringFormat=\{0:dd MMM yyyy\}}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
											<TextBlock Text="{Binding ImportDate, StringFormat=\{0:HH:mm\}}" FontSize="12" Foreground="#999" HorizontalAlignment="Right"/>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<!-- Action Bar -->
					<Border Grid.Row="1" Background="#F8F9FA" Padding="15" CornerRadius="8" Margin="0,10,0,0">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
							<Button Content="View Details" Command="{Binding OpenImportDetailCommand}" Style="{StaticResource EditButton}" Margin="0,0,10,0"/>
							<Button Content="Delete Record" Command="{Binding DeleteImportCommand}" Style="{StaticResource DeleteButton}"/>
						</StackPanel>
					</Border>

					<controls:MessageBanner HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Panel.ZIndex="100"/>
				</Grid>
			</TabItem>
        </TabControl>
    </Grid>
</Page>
