<Page x:Class="QL_Nha_sach.Pages.BookManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages" xmlns:viewmodels="clr-namespace:QL_Nha_sach.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:BookViewModel}"
      xmlns:controls="clr-namespace:QL_Nha_sach.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookManagementPage">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Controls/SharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
		</ResourceDictionary>
	</Page.Resources>

	<Grid Margin="30" Background="#F9FAFB">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Header -->
			<RowDefinition Height="*"/>
			<!-- Main Content -->
			<RowDefinition Height="Auto"/>
			<!-- Footer Actions -->
		</Grid.RowDefinitions>

		<!-- Header Section -->
		<Grid Grid.Row="0" Margin="0,0,0,24">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<TextBlock Text="{DynamicResource Str_Inventory}" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,0,20,0"/>
				<Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="8,4">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,8,0" Foreground="#9CA3AF"/>
						<TextBox Width="300" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
				</Border>

				<StackPanel Margin="0,0,16,0">
					<TextBlock Text="{DynamicResource Str_Genre}" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4"/>
					<ComboBox ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}" DisplayMemberPath="GenreName" Width="140" Padding="8,6"/>
				</StackPanel>

				<!-- Author Dropdown -->
				<StackPanel Margin="0,0,16,0">
					<TextBlock Text="{DynamicResource Str_Author}" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4"/>
					<ComboBox ItemsSource="{Binding Authors}" SelectedItem="{Binding SelectedAuthor}" DisplayMemberPath="AuthorName" Width="140" Padding="8,6"/>
				</StackPanel>

				<!-- Reset Button -->
				<Button Command="{Binding ClearFiltersCommand}" Content="{DynamicResource Str_ResetFilters}" VerticalAlignment="Bottom" Padding="12,7" Background="Transparent" BorderBrush="#D1D5DB" Foreground="#374151" Cursor="Hand">
					<Button.Resources>
						<Style TargetType="Border">
							<Setter Property="CornerRadius" Value="6"/>
						</Style>
					</Button.Resources>
				</Button>
			</StackPanel>

			<!-- Exit button -->
			<Button Content="✖" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ExitButton}" Click="ExitButton_Click"/>
		</Grid>

		<!-- Main Content -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*"/>
				<!-- List -->
				<ColumnDefinition Width="*"/>
				<!-- Detail -->
			</Grid.ColumnDefinitions>

			<ListBox Grid.Column="0" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" Background="Transparent" BorderThickness="0" Margin="0,0,16,0" 
					 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingStackPanel.ScrollUnit="Pixel" HorizontalContentAlignment="Stretch">
				<ListBox.Resources>
					<Style TargetType="ScrollBar">
						<Setter Property="MinWidth" Value="0"/>
						<Setter Property="MinHeight" Value="0"/>
						<Setter Property="Width" Value="6"/>
					</Style>
					<Style TargetType="ListBoxItem">
						<!-- This removes the 'ghost' margin/padding ListBox adds by default -->
						<Setter Property="Padding" Value="0"/>
						<Setter Property="Margin" Value="8"/>
						<Setter Property="Background" Value="Transparent"/>
					</Style>
				</ListBox.Resources>

				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal"/>
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>

				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Width="180" Height="320" Margin="4" CornerRadius="12" Background="White" BorderBrush="#F3F4F6" BorderThickness="1">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="5*" />
									<RowDefinition Height="2*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<Image Grid.Row="0" Source="{Binding CoverImageUrl}" VerticalAlignment="Stretch"/>

								<StackPanel Grid.Row="1" Margin="0,12,0,12">
									<TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#111827" MaxHeight="40" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
									<TextBlock Text="{Binding AuthorNames}" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
								</StackPanel>

								<!-- Price & Stock -->
								<Grid Grid.Row="2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TextBlock Text="{Binding Price, StringFormat={}{0:C0}}" Foreground="#059669" FontWeight="Bold" FontSize="14"/>
									<TextBlock Grid.Column="1" Text="{Binding Stock, StringFormat={}Qty: {0}}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
								</Grid>
							</Grid>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<!-- Right Side Detail View -->
			<Border Grid.Column="1" Background="White" CornerRadius="24" Padding="32" BorderBrush="#F3F4F6" BorderThickness="1">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<!-- Cover -->
						<RowDefinition Height="*"/>
						<!-- Details -->
					</Grid.RowDefinitions>

					<Border Grid.Row="0" CornerRadius="12" Background="#F9FAFB" MaxHeight="400" Margin="0,0,0,32">
						<Border.Effect>
							<DropShadowEffect BlurRadius="30" Opacity="0.1" ShadowDepth="10" Color="Black"/>
						</Border.Effect>
						<Image Source="{Binding SelectedBook.CoverImageUrl}" Stretch="Uniform" Margin="10"/>
					</Border>

					<StackPanel Grid.Row="1">
						<TextBlock Text="{Binding SelectedBook.Title}" FontSize="24" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="30"/>
						<TextBlock Text="{Binding SelectedBook.AuthorNames}" FontSize="16" Foreground="#6B7280" Margin="0,8,0,0"/>

						<Border HorizontalAlignment="Left" Background="#ECFDF5" CornerRadius="6" Padding="8,4" Margin="0,16,0,16">
							<TextBlock Text="{Binding SelectedBook.BookStatus.StatusName}" Foreground="#065F46" FontSize="12" FontWeight="SemiBold"/>
						</Border>

						<!-- Metadata Grid for neat alignment -->
						<Grid Margin="0,8,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="80"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<!-- Labels -->
							<TextBlock Text="ISBN" Grid.Row="0" Foreground="#9CA3AF" FontSize="12" Margin="0,4"/>
							<TextBlock Text="{DynamicResource Str_Genre}" Grid.Row="1" Foreground="#9CA3AF" FontSize="12" Margin="0,4"/>
							<TextBlock Text="{DynamicResource Str_Publisher}" Grid.Row="2" Foreground="#9CA3AF" FontSize="12" Margin="0,4"/>

							<!-- Values -->
							<TextBlock Text="{Binding SelectedBook.ISBN}" Grid.Column="1" Grid.Row="0" Foreground="#374151" FontSize="12" FontWeight="Medium" Margin="0,4"/>
							<TextBlock Text="{Binding SelectedBook.GenreNames}" Grid.Column="1" Grid.Row="1" Foreground="#374151" FontSize="12" FontWeight="Medium" Margin="0,4"/>
							<TextBlock Text="{Binding SelectedBook.Publisher.PublisherName}" Grid.Column="1" Grid.Row="2" Foreground="#374151" FontSize="12" FontWeight="Medium" Margin="0,4" TextWrapping="Wrap"/>
						</Grid>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

		<!-- Footer Actions -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0" Visibility="{Binding IsManager, Converter={StaticResource BoolToVisConverter}}">
			<Button Content="{DynamicResource Str_Add}" Command="{Binding AddBookCommand}" Style="{StaticResource SaveButton}"/>
			<Button Content="{DynamicResource Str_Edit}" Command="{Binding EditBookCommand}" Margin="12,0" Width="100" Height="40" Background="White" BorderBrush="#E5E7EB"/>
			<Button Content="{DynamicResource Str_Delete}" Command="{Binding DeleteBookCommand}" Width="100" Height="40" Background="White" Foreground="#DC2626" BorderBrush="#FEE2E2"/>
		</StackPanel>

		<controls:MessageBanner HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Panel.ZIndex="100"/>
	</Grid>
</Page>
