<Page x:Class="QL_Nha_sach.Pages.TransactionListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TransactionListPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Search bar -->
            <RowDefinition Height="*"/>
            <!-- Book list -->
            <RowDefinition Height="Auto"/>
            <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- Exit button -->
        <Button Content="✖"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="30" Height="30"
                Background="Transparent"
                BorderThickness="0"
                Foreground="Red"
                FontWeight="Bold"
                Click="ExitButton_Click"/>

        <TabControl>
            <TabItem Header="Invoices" IsSelected="True">
                <DockPanel>
                    <DataGrid x:Name="InvoiceGrid"
                      ItemsSource="{Binding Invoices}"
                      SelectedItem="{Binding SelectedInvoice}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      DockPanel.Dock="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice ID" Binding="{Binding InvoiceId}" />
                            <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate}" />
                            <DataGridTextColumn Header="Staff" Binding="{Binding User.FullName}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding IsVoided}" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5" DockPanel.Dock="Bottom">
                        <Button Content="View Detail" Command="{Binding OpenInvoiceDetailCommand}" />
                    </StackPanel>
                </DockPanel>
            </TabItem>

            <!-- Imports Tab -->
            <TabItem Header="Imports">
                <DockPanel>
                    <DataGrid x:Name="ImportGrid"
                      ItemsSource="{Binding Imports}"
                      SelectedItem="{Binding SelectedImport}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      DockPanel.Dock="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Import ID" Binding="{Binding ImportId}" />
                            <DataGridTextColumn Header="Date" Binding="{Binding ImportDate}" />
                            <DataGridTextColumn Header="Staff" Binding="{Binding User.FullName}" />
                            <DataGridTextColumn Header="Total Cost" Binding="{Binding Total}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5" DockPanel.Dock="Bottom">
                        <Button Content="View Detail" Command="{Binding OpenImportDetailCommand}"/>
                    </StackPanel>
                </DockPanel>
            </TabItem>
        </TabControl>

    </Grid>
</Page>
