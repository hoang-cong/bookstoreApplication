<Page x:Class="QL_Nha_sach.Pages.PromotionListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PromotionListPage">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Line items -->
            <RowDefinition Height="Auto"/>
            <!-- Totals + buttons -->
        </Grid.RowDefinitions>

		<StackPanel Margin="30,10,0,0">
			<TextBlock Text="Promotions Management" FontSize="30" FontWeight="Bold" Foreground="#1A1A1A"/>
			<TextBlock Text="Manage active and upcoming bookstore discounts" Foreground="#8E8E93" FontSize="20"/>
		</StackPanel>
        <Button Content="✖" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ExitButton}" Click="ExitButton_Click"/>

		<ListBox Grid.Row="1" ItemsSource="{Binding Promotions}" SelectedItem="{Binding SelectedPromotion}" Background="White"
				 BorderThickness="2" HorizontalContentAlignment="Stretch" Margin="10,30,10,10">
			<ListBox.Resources>
					<Style TargetType="ScrollBar">
						<Setter Property="MinWidth" Value="0"/>
						<Setter Property="MinHeight" Value="0"/>
						<Setter Property="Width" Value="6"/>
					</Style>
				</ListBox.Resources>
			
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border Background="#E6E7E8" CornerRadius="12" Margin="10" Padding="20">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<!-- Icon/Badge -->
								<ColumnDefinition Width="2*"/>
								<!-- Name/ID -->
								<ColumnDefinition Width="*"/>
								<!-- Dates -->
								<ColumnDefinition Width="Auto"/>
								<!-- Discount -->
							</Grid.ColumnDefinitions>

							<Border Width="45" Height="45" Background="#F2F2F7" CornerRadius="8">
								<TextBlock Text="🏷️" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
							</Border>

							<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
								<TextBlock Text="{Binding PromotionName}" FontSize="20" FontWeight="SemiBold" Foreground="#1C1C1E"/>
								<TextBlock Text="{Binding PromotionId, StringFormat=Promotion ID: {0}}" FontSize="20" Foreground="#8E8E93"/>
							</StackPanel>

							<StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,30,0">
								<TextBlock Text="{Binding StartDate, StringFormat=Start Date: {0}}" FontSize="16" Foreground="#3A3A3C"/>
								<TextBlock Text="{Binding EndDate, StringFormat=End Date: {0}}" FontSize="16" Foreground="#FF3B30"/>
							</StackPanel>

							<Border Grid.Column="3" Background="#E8F5E9" Padding="12,6" CornerRadius="15" VerticalAlignment="Center">
								<TextBlock Text="{Binding Discount, StringFormat=Discount (%): {0}}" Foreground="#2E7D32" FontWeight="Bold" FontSize="16"/>
							</Border>
						</Grid>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5" DockPanel.Dock="Bottom">
			<Button Content="Add" Command="{Binding AddPromotionCommand}" Style="{StaticResource SaveButton}" Margin="5"/>
			<Button Content="Edit" Command="{Binding EditPromotionCommand}" Style="{StaticResource EditButton}" Margin="5"/>
			<Button Content="Delete" Command="{Binding DeletePromotionCommand}" Style="{StaticResource DeleteButton}" Margin="5"/>
		</StackPanel>
    </Grid>
</Page>
