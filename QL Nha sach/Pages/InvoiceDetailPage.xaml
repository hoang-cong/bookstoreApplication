<Page x:Class="QL_Nha_sach.Pages.InvoiceDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages"
      xmlns:controls="clr-namespace:QL_Nha_sach.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InvoiceDetailPage">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Controls/SharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Page.Resources>

	<Grid Margin="32" Background="#F9FAFB">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Header -->
			<RowDefinition Height="*"/>
			<!-- Items Table -->
			<RowDefinition Height="Auto"/>
			<!-- Summary & Actions -->
		</Grid.RowDefinitions>

		<!-- 1. HEADER SECTION -->
		<Grid Grid.Row="0" Margin="0,0,0,24">
			<StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<TextBlock Text="INVOICE" FontSize="12" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding InvoiceId, StringFormat='#{0}'}" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="12,0,0,0"/>

					<!-- Status Badge -->
					<Border Margin="16,0,0,0" Padding="8,2" CornerRadius="12" VerticalAlignment="Center" BorderThickness="1">
						<TextBlock Style="{StaticResource VoidedStatusTextStyle}" Margin="0,4,0,0"/>
					</Border>
				</StackPanel>

				<UniformGrid Columns="3" Margin="0,8,0,0">
					<StackPanel>
						<TextBlock Text="DATE" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
						<TextBlock Text="{Binding Date, StringFormat='{}{0:MMM dd, yyyy}'}" FontSize="14" Foreground="#374151" FontWeight="Medium"/>
					</StackPanel>
					<StackPanel>
						<TextBlock Text="PROCESSED BY" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
						<TextBlock Text="{Binding StaffName}" FontSize="14" Foreground="#374151" FontWeight="Medium"/>
					</StackPanel>
				</UniformGrid>
			</StackPanel>

			<Button Content="✖" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ExitButton}" Click="ExitButton_Click"/>
		</Grid>

		<!-- 2. LINE ITEMS SECTION -->
		<Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="1">
			<DataGrid ItemsSource="{Binding Details}"
					  AutoGenerateColumns="False"
					  IsReadOnly="True"
					  Background="Transparent"
					  BorderThickness="0"
					  GridLinesVisibility="None"
					  HeadersVisibility="Column"
					  RowHeight="45"
					  HorizontalScrollBarVisibility="Disabled">
				<DataGrid.Resources>
					<Style TargetType="DataGridColumnHeader">
						<Setter Property="Background" Value="#F9FAFB"/>
						<Setter Property="Foreground" Value="#6B7280"/>
						<Setter Property="FontWeight" Value="SemiBold"/>
						<Setter Property="Padding" Value="12,10"/>
						<Setter Property="BorderThickness" Value="0,0,0,1"/>
						<Setter Property="BorderBrush" Value="#E5E7EB"/>
					</Style>
				</DataGrid.Resources>

				<DataGrid.Columns>
					<DataGridTextColumn Header="BOOK ITEM" Binding="{Binding Book.Title}" Width="2*" />
					<DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="80"/>
					<DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="120"/>
					<DataGridTextColumn Header="DISCOUNT" Binding="{Binding Discount, StringFormat={}{0}%}" Width="100"/>
					<DataGridTextColumn Header="SUBTOTAL" Binding="{Binding SubTotal, StringFormat={}{0:C}}" Width="120">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="FontWeight" Value="Bold"/>
								<Setter Property="Foreground" Value="#111827"/>
								<Setter Property="HorizontalAlignment" Value="Right"/>
								<Setter Property="Margin" Value="0,0,12,0"/>
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>

		<!-- 3. FOOTER & SUMMARY -->
		<Grid Grid.Row="2" Margin="0,24,0,0">
			<!-- Actions -->
			<StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
				<Button Content="Void Invoice" Command="{Binding VoidInvoiceCommand}" Style="{StaticResource DeleteButton}"/>
			</StackPanel>

			<!-- Financial Summary -->
			<StackPanel HorizontalAlignment="Right" Width="250">
				<Grid Margin="0,4">
					<TextBlock Text="Total Amount" FontSize="14" Foreground="#6B7280"/>
					<TextBlock Text="{Binding TotalPrice, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Right"/>
				</Grid>
				<Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,8"/>
			</StackPanel>
		</Grid>

		<controls:MessageBanner HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Panel.ZIndex="100"/>
	</Grid>
</Page>
