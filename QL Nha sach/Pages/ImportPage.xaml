<Page x:Class="QL_Nha_sach.Pages.ImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QL_Nha_sach.Pages"
      xmlns:controls="clr-namespace:QL_Nha_sach.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ImportPage">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Controls/SharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Page.Resources>

	<Grid Margin="24" Background="#F9FAFB">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Status Bar -->
			<RowDefinition Height="Auto"/>
			<!-- Scanning Section -->
			<RowDefinition Height="*"/>
			<!-- Data Table -->
			<RowDefinition Height="Auto"/>
			<!-- Totals & Actions -->
		</Grid.RowDefinitions>

		<!-- 1. Top Status Bar (Subtle info) -->
		<Border Grid.Row="0" Background="White" Padding="15,10" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,20">
			<Grid>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="📅" Margin="0,0,8,0" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding Date}" Foreground="#4B5563" FontWeight="Medium" VerticalAlignment="Center"/>

					<Separator Width="1" Height="15" Margin="20,0" Background="#E5E7EB"/>

					<TextBlock Text="{DynamicResource Str_Stocker}" Foreground="#6B7280" Margin="0,0,8,0" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding StaffName}" Foreground="#111827" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel>

				<!-- Exit button -->
				<Button Content="✖" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ExitButton}" Click="ExitButton_Click"/>
			</Grid>
		</Border>

		<!-- 2. Action/Scanning Section -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
			<StackPanel>
				<TextBlock Text="{DynamicResource Str_QuickScanISBN}" FontSize="12" FontWeight="Bold" Foreground="#4F46E5" Margin="0,0,0,5"/>
				<StackPanel Orientation="Horizontal">
					<TextBox Width="300" Height="45" FontSize="18" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="10,0" Text="{Binding ScannedISBN, UpdateSourceTrigger=PropertyChanged}" BorderBrush="#4F46E5" BorderThickness="2">
						<!-- Allows Enter Key to Add -->
						<TextBox.InputBindings>
							<KeyBinding Key="Enter" Command="{Binding AddScannedBookCommand}"/>
						</TextBox.InputBindings>
					</TextBox>
					<Button Content="{DynamicResource Str_AddtoList}" Command="{Binding AddScannedBookCommand}" Style="{StaticResource SaveButton}" Height="45" Margin="12,0,0,0" Width="120"/>
				</StackPanel>
			</StackPanel>
		</StackPanel>

		<!-- 3. Line Items Table -->
		<Border Grid.Row="2" Background="White" CornerRadius="12,12,0,0" BorderBrush="#E5E7EB" BorderThickness="1" Padding="5">
			<DataGrid ItemsSource="{Binding Details}" SelectedItem="{Binding SelectedDetail, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6" BorderThickness="0" Background="Transparent" RowHeight="40">
				<DataGrid.ColumnHeaderStyle>
					<Style TargetType="DataGridColumnHeader">
						<Setter Property="Background" Value="#F9FAFB"/>
						<Setter Property="Foreground" Value="#6B7280"/>
						<Setter Property="FontWeight" Value="SemiBold"/>
						<Setter Property="Padding" Value="10"/>
						<Setter Property="BorderThickness" Value="0,0,0,1"/>
						<Setter Property="BorderBrush" Value="#E5E7EB"/>
					</Style>
				</DataGrid.ColumnHeaderStyle>

				<DataGrid.Columns>
					<DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="130"/>
					<DataGridTextColumn Header="{DynamicResource Str_Title}" Binding="{Binding Title}" IsReadOnly="True" Width="*"/>
					<DataGridTextColumn Header="{DynamicResource Str_Quantity}" Binding="{Binding Quantity}" Width="80"/>
					<DataGridTextColumn Header="{DynamicResource Str_Price}" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" IsReadOnly="True" Width="100"/>
					<DataGridTextColumn Header="{DynamicResource Str_SubTotal}" Binding="{Binding SubTotal, StringFormat={}{0:C}}" IsReadOnly="True" Width="120" FontWeight="Bold"/>

					<!-- Action Column -->
					<DataGridTemplateColumn Width="100">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Button Content="{DynamicResource Str_Delete}" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Foreground="#DC2626" Background="Transparent" BorderThickness="0" FontSize="11"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>

		<!-- 4. Footer: Totals and Saving -->
		<Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,0,1,1" CornerRadius="0,0,12,12" Padding="20">
			<Grid>
				<StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
					<TextBlock Text="{DynamicResource Str_Items}" Foreground="#6B7280" FontSize="14"/>
					<TextBlock Text="{Binding Details.Count}" Foreground="#6B7280" FontSize="14"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<StackPanel VerticalAlignment="Center" Margin="0,0,30,0">
						<TextBlock Text="{DynamicResource Str_TotalAmount}" HorizontalAlignment="Right" Foreground="#6B7280" FontSize="12"/>
						<TextBlock Text="{Binding Total, StringFormat={}{0:C}}" FontSize="32" FontWeight="Black" Foreground="#059669"/>
					</StackPanel>

					<Button Content="{DynamicResource Str_Save}" Command="{Binding SaveFormCommand}" Style="{StaticResource SaveButton}"/>
				</StackPanel>
			</Grid>
		</Border>

		<controls:MessageBanner HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" Panel.ZIndex="100"/>
	</Grid>
</Page>
